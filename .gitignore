# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .env.example은 커밋 대상 (키 없는 템플릿)
!.env.example

# 로컬 작업 문서 (커밋 금지)
야간스팟_검수목록.md

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# 브라우저 확인용 임시 스크립트 (Playwright) — 커밋하지 않는다
*.local.mjs

# 브라우저 확인용 스크린샷 (커밋 대상 아님)
/tour-screenshots/
